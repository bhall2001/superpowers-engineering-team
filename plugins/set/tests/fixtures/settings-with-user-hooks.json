{
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/example/.claude/hooks/preload-serena.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/example/.claude/hooks/prefer-serena.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
